CLIENT_ID=your_google_client_id_here
CLIENT_SECRET=your_google_client_secret_here
REDIRECT_URI=http://localhost:3000/oauth2callback
WEBHOOK_URL=https://your-public-tunnel-url.com/webhook
PORT=3000
DEBUG_RAW_EVENTS = false

# Administrative security token for teardown actions (Automatically populated via npm run setup)
ADMIN_TOKEN=your_generated_secret_token_will_populate_here